# Estadistica webroot hygiene (farmacia's, which is epidemiologia's lesson: 4.9 MB of
# generated files served to anyone). The app serves only js/, img/ and templates/;
# everything else 404s, never 403s, so the server is not an existence oracle.
Options -Indexes
<FilesMatch "^(composer\.json|composer\.lock|package\.json|package-lock\.json|openapi\.json|phpunit.*\.xml|Makefile|Dockerfile.*|\.gitignore|\.gitattributes)$">
	Require all denied
</FilesMatch>
<FilesMatch "\.map$">
	Require all denied
</FilesMatch>
RewriteEngine On
# seeds/ and docs/ are repo material too: the metas seed reaches the database
# through the app, never over HTTP.
RewriteRule ^(src|tests|lib|appinfo|scripts|seeds|docs|tools|node_modules|vendor|\.git)(/|$) - [R=404,L]
